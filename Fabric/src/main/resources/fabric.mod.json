{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_full_name}",
  "description": "${mod_description}",
  "authors": [
    "Joosh",
    "YUNGNICKYOUNG",
    "HellionGames",
    "Refresh Studios"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/ribbits",
    "sources": "https://github.com/yungnickyoung/Ribbits",
    "issues": "https://github.com/yungnickyoung/Ribbits/issues",
    "discord": "discord.gg/sGwxnFV"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.yungnickyoung.minecraft.ribbits.fabric.RibbitsFabric"
    ],
    "client": [
      "com.yungnickyoung.minecraft.ribbits.fabric.client.RibbitsFabricClient"
    ],
    "modmenu": [
      "com.yungnickyoung.minecraft.ribbits.fabric.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "ribbits.mixins.json",
    "ribbits.fabric.mixins.json",
    "yungsapi.mixins.json",
    "yungsapi_fabric.mixins.json"
  ],
  "accessWidener": "ribbits.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": ">=${mc_version}",
    "cloth-config2": ">=${clothconfig_version_fabric}",
    "java": ">=${java_version}",
    "geckolib": ">=${geckolib_version_fabric}"
  }
}
